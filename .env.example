# 复制为`.env`并填写实际值。`.env`已被`.gitignore`忽略，不会提交。

# just 使用的 Python，可跳过 poetry，稍快一些。在虚拟环境中可设为`./.venv/bin/python`（Windows 为`./.venv/Scripts/python.exe`）。
PYTHON = "./.venv/bin/python"

# 生产环境。非空即启用生产设置（PostgreSQL、安全 Cookie 等）。
DJANGO_PRODUCTION=1
# 必须替换为足够长的随机字符串，且需保密。
SECRET_KEY=replace-me-with-a-long-random-value

# PostgreSQL 数据库连接信息。
POSTGRES_DB=contest
POSTGRES_USER=contest
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# 可选：设为非空则忽略答题开放时间限制。
# DJANGO_DISABLE_QUIZ_OPENING_TIME_INTERVAL=1
